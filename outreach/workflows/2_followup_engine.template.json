            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Assess Reply": {
      "main": [
        [
          {
            "node": "Replied?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Replied?": {
      "main": [
        [
          {
            "node": "Set Replied",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Build Bump Prompt",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Set Replied": {
      "main": [
        [
          {
            "node": "Sheets: Mark Replied",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build Bump Prompt": {
      "main": [
        [
          {
            "node": "Claude: Bump",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Claude: Bump": {
      "main": [
        [
          {
            "node": "Parse Bump",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Parse Bump": {
      "main": [
        [
          {
            "node": "Gmail: Send Follow-up",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Gmail: Send Follow-up": {
      "main": [
        [
          {
            "node": "Prep Update",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Prep Update": {
